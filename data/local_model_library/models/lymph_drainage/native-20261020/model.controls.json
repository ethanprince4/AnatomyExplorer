  "parts": [
    {
      "name": "Thoracic duct",
      "group": "Thoracic duct system",
      "color": "#3f9e4d",
      "color_linear": [
        0.04971,
        0.34191,
        0.07421
      ],
      "description": "Thoracic duct: the largest lymphatic vessel. It begins at the cisterna chyli, rises through the aortic hiatus of the diaphragm, runs up the posterior mediastinum on the vertebral bodies between the aorta and the azygos vein (behind the oesophagus), crosses to the left at about T4-T5, and arches at the root of the neck to empty into the left venous angle, where the left internal jugular and left subclavian veins meet. It drains the remainder of the body: everything except the right side of the head and neck, the right upper limb and the right thorax.",
      "alpha": 1.0,
      "category": "lymph",
      "label": true,
      "rank": 1.0,
      "clip": true,
      "bulk": false,
      "detail": [
        0.0,
        0.0,
        0.0,
        0.0
      ]
    },
    {
